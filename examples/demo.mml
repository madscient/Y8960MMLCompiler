; Y8960 MML - a short demo
;
; Four parts: an FM lead on a voice this file builds, an SCC bass on a
; waveform it builds too, a preset FM pad and a rhythm track.

#assign A OPL2EX1 0
#assign B SCC 0
#assign C OPL2EX1 1
#assign D OPL2EX1 10

#define TEMPO 132
#define RIFF  "cdefgab>c<"

; a voice of our own, in the shape VOICE COPY moves
#voice 128 "Lead    ", \
           $00,$00,$0A,$00,$00,$00,$00,$00, \
           $31,$0E,$D9,$11,$30,$00,$00,$00, \
           $11,$00,$B2,$F4,$70,$00,$00,$00

; a sawtooth for the bass
#wave 16 -124,-116,-108,-100, -92, -84, -76, -68, \
          -60, -52, -44, -36, -28, -20, -12,  -4, \
            4,  12,  20,  28,  36,  44,  52,  60, \
           68,  76,  84,  92, 100, 108, 116, 124

A  T=TEMPO; @128 V13 Q7 O4 L8 |: XRIFF; [1 >c4.< ] [2 >e4.< ] :|2
B  @16 V12 O2 L4 |: c g c g :|2
C  @6 V9 O3 L2 |: c e :|2
D  V10 @A14 |: B8 H8 S!8 H8 :|2
